{
  "manifest_version": 3,
  "name": "雅译 · 浏览器翻译",
  "version": "0.1.4",
  "description": "将网页与视频字幕翻译成自然、准确的中文，支持 OpenAI、Gemini、DeepL 和自定义 API。",
  "icons": { "16": "assets/icon-16.png", "48": "assets/icon-48.png", "128": "assets/icon-128.png" },
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "src/background.js" },
  "action": {
    "default_title": "雅译",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "assets/icon-16.png", "48": "assets/icon-48.png" }
  },
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["src/content.js"],
    "css": ["src/content.css"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "commands": {
    "translate-page": {
      "suggested_key": { "default": "Alt+Shift+T", "mac": "MacCtrl+Shift+T" },
      "description": "翻译/还原当前网页"
    }
  }
}
